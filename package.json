{
  "name": "pimas-ui",
  "version": "0.2.0",
  "description": "Exact what-if over a live reactive model. Drop it into React; an agent can simulate against the same graph without committing.",
  "type": "module",
  "license": "MIT",
  "author": "Noah Hyden",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noahhyden/pimas.git"
  },
  "homepage": "https://github.com/noahhyden/pimas#readme",
  "bugs": "https://github.com/noahhyden/pimas/issues",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/reactive/index.d.ts",
      "import": "./dist/reactive/index.js"
    },
    "./store": {
      "types": "./dist/store/index.d.ts",
      "import": "./dist/store/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "import": "./dist/agent/index.js"
    },
    "./agent/webmcp": {
      "types": "./dist/agent/webmcp.d.ts",
      "import": "./dist/agent/webmcp.js"
    },
    "./agent/page": {
      "types": "./dist/agent/page.d.ts",
      "import": "./dist/agent/page.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "size": "node scripts/size.mjs",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "keywords": [
    "reactive",
    "signals",
    "speculate",
    "what-if",
    "agent"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitest/coverage-v8": "^3.2.6",
    "esbuild": "^0.24.2",
    "happy-dom": "^16.5.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
